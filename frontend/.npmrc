# Electron 二进制（electron-v<version>-<platform>-<arch>.zip）下载镜像
# npm 会把这里的键注入为 npm_config_* 环境变量，@electron/get 与 electron-builder 都会读取
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 打包工具链（NSIS、winCodeSign、wine 等）下载镜像
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
